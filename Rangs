-- ============================================================
--  SYSTEM RANG + ROZSZERZENIE KOLORÓW INDIKATORÓW
-- ============================================================

-- == System Rang == --
do
    -- 1. Nazwa folderu rang
    local FOLDER_NAME = "MuminekRangs"

    -- 2. Lista dozwolonych rang (bezpieczeństwo — ignorujemy inne pliki)
    local ALLOWED_RANKS = {
        ["Owner"]     = true,
        ["Moderator"] = true,
        ["Premium"]   = true,
    }

    -- 3. Tworzenie folderu jeśli nie istnieje
    if not isfolder(FOLDER_NAME) then
        local success, err = pcall(makefolder, FOLDER_NAME)
        if success then
            print("[System Rang] Folder utworzony: " .. FOLDER_NAME)
        else
            warn("[System Rang] Nie udało się utworzyć folderu: " .. tostring(err))
        end
    end

    -- 4. Sprawdzanie plików z rangami
    local foundRank = nil
    local foundFile = nil

    local files = listfiles(FOLDER_NAME)
    for _, filePath in pairs(files) do
        local fileName = filePath:match("([^/\\]+)$")
        if fileName then
            local rankName = fileName:match("^(.+)%.txt$")
            if rankName and ALLOWED_RANKS[rankName] then
                foundRank = rankName
                foundFile = filePath
                break
            end
        end
    end

    -- 5. Ustawienie zmiennych globalnych i wykonanie akcji
    if foundRank then
        -- Globalne zmienne rangi
        _G.PlayerRank    = foundRank
        _G.IsRanked      = true
        _G.IsOwner       = (foundRank == "Owner")
        _G.IsModerator   = (foundRank == "Moderator")
        _G.IsPremium     = (foundRank == "Premium")

        _G.UserRank      = false
        _G.OwnerRank     = _G.IsOwner
        _G.ModeratorRank = _G.IsModerator
        _G.PremiumRank   = _G.IsPremium

        -- Powiadomienie
        if Notification and Notification.new then
            Notification.new({
                Title   = "Ranga: " .. foundRank,
                Content = "Masz dostęp do funkcji przypisanych do rangi " .. foundRank .. ".",
                Duration = 5,
            })
        end

        -- Log
        if Logging and Logging.new then
            Logging.new("shield-lock", "Zweryfikowano rangę: " .. foundRank, 5)
        end

    else
        -- Brak rangi — tryb podstawowy (User)
        _G.PlayerRank    = "User"
        _G.IsRanked      = false
        _G.IsOwner       = false
        _G.IsModerator   = false
        _G.IsPremium     = false

        _G.UserRank      = true
        _G.OwnerRank     = false
        _G.ModeratorRank = false
        _G.PremiumRank   = false

        if Logging and Logging.new then
            Logging.new("person", "Brak przypisanej rangi – tryb podstawowy", 3)
        end
    end
end

-- ============================================================
--  ROZSZERZENIE KOLORÓW DLA INDIKATORÓW
-- ============================================================
do
    local colorTable = Indicators and Indicators.Color

    if not colorTable then
        warn("[Kolory] Indicators.Color niedostępne — pomijam rozszerzenie palety")
    else
        colorTable.Red     = Color3.fromRGB(255, 0, 0)
        colorTable.Green   = Color3.fromRGB(0, 255, 0)
        colorTable.Blue    = Color3.fromRGB(0, 0, 255)
        colorTable.Yellow  = Color3.fromRGB(255, 255, 0)
        colorTable.Orange  = Color3.fromRGB(255, 165, 0)
        colorTable.White   = Color3.fromRGB(255, 255, 255)
        colorTable.Pink    = Color3.fromRGB(255, 105, 180)
        colorTable.Purple  = Color3.fromRGB(160, 32, 240)
        colorTable.Cyan    = Color3.fromRGB(0, 255, 255)
        colorTable.Gold    = Color3.fromRGB(255, 215, 0)
        colorTable.Lime    = Color3.fromRGB(50, 205, 50)
        colorTable.Magenta = Color3.fromRGB(255, 0, 255)
        colorTable.Silver  = Color3.fromRGB(192, 192, 192)
        colorTable.Teal    = Color3.fromRGB(0, 128, 128)
    end
end

-- ============================================================
--  USTAWIENIE RANGI W OKNIE (SetAccount)
--  Używa _G zamiast luźnych zmiennych
-- ============================================================
if _G.UserRank then
    window:SetAccount({ Expires = "User" })
elseif _G.OwnerRank then
    window:SetAccount({ Expires = "Owner" })
elseif _G.PremiumRank then
    window:SetAccount({ Expires = "Premium" })
elseif _G.ModeratorRank then
    window:SetAccount({ Expires = "Moderator" })
end
